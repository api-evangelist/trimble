{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trimble Connect BCF Topics Users API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List project members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.connect.trimble.com/tc/api/2.0/projects/:projectId/members",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Trimble Connect project UUID"
              }
            ]
          },
          "docs": "Returns all users and their roles within a project."
        }
      ]
    }
  ],
  "bundled": true
}