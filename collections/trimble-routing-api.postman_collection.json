  "item": [
    {
      "id": "109eef6a-27c0-4321-939e-6475f4631cd1",
      "name": "Routing",
      "description": {
        "content": "Route calculation and optimization",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "453b9a63-bba7-45a4-8be8-4f7c4dfb5846",
          "name": "Calculate a route between stops",
          "request": {
            "name": "Calculate a route between stops",
            "description": {
              "content": "Calculates an optimized route for commercial vehicles between multiple stops. Returns mileage, drive time, toll costs, and turn-by-turn directions optimized for truck dimensions, weight, and hazmat restrictions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Service.svc",
                "route"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "stops",
                  "value": "<string>",
                  "description": "(Required) Semicolon-delimited list of stops in \"City,State\" or lat/lng format. Example: \"Dallas,TX;Chicago,IL;Detroit,MI\""
                },
                {
                  "disabled": false,
                  "key": "vehicleType",
                  "value": "Truck"
                },
                {
                  "disabled": false,
                  "key": "routeType",
                  "value": "Practical",
                  "description": "Routing optimization type"
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "<number>",
                  "description": "Vehicle height in feet"
                },
                {
                  "disabled": false,
                  "key": "weight",
                  "value": "<number>",
                  "description": "Vehicle weight in pounds"
                },
                {
                  "disabled": false,
                  "key": "length",
                  "value": "<number>",
                  "description": "Vehicle length in feet"
                },
                {
                  "disabled": false,
                  "key": "hazmat",
                  "value": "None"
                },
                {
                  "disabled": false,
                  "key": "reportType",
                  "value": "Mileage"
                },
                {
                  "disabled": false,
                  "key": "outputFormat",
                  "value": "json"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
