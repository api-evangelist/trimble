{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trimble Connect BCF Topics Projects API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.connect.trimble.com/tc/api/2.0/projects",
            "params": [
              {
                "name": "includeDeleted",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of Trimble Connect projects accessible to the authenticated user."
        },
        {
          "info": {
            "name": "Create a project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.connect.trimble.com/tc/api/2.0/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Trimble Connect project."
        },
        {
          "info": {
            "name": "Get project details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.connect.trimble.com/tc/api/2.0/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Trimble Connect project UUID"
              }
            ]
          },
          "docs": "Returns detailed information for a specific project."
        },
        {
          "info": {
            "name": "Update a project",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.connect.trimble.com/tc/api/2.0/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Trimble Connect project UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates mutable project properties such as name, description, and status."
        }
      ]
    }
  ],
  "bundled": true
}