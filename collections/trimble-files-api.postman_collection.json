  "info": {
    "_postman_id": "098f0b35-9fe8-4e57-b356-4bbdbb3f19ac",
    "name": "Trimble Connect BCF Topics Files API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Trimble Connect API enables integration with Trimble's cloud-based construction collaboration platform. Provides access to project data, BIM models, document management, issues (BCF Topics), and team collaboration features for construction project management. Trimble Connect acts as the BIM collaboration hub integrating Tekla, SketchUp, and third-party tools.\n\nContact Support:\n Name: Trimble Developer Support",
      "type": "text/plain"
    }
